---
import BaseLayout from './BaseLayout.astro'
import { AdminSidebar } from '@/components/organisms/admin/AdminSidebar'
import { AdminTopbar } from '@/components/organisms/admin/AdminTopbar'
import { Breadcrumb, type Crumb } from '@/components/molecules/Breadcrumb'

interface Props {
  title: string
  heading: string
  description?: string
  breadcrumbs?: Crumb[]
}

const { title, heading, description, breadcrumbs = [] } = Astro.props
---

<BaseLayout title={`${title} · Admin`} noindex bodyClass="bg-cream-100/60">
  <div class="min-h-screen lg:pl-68">
    <AdminSidebar client:load currentPath={Astro.url.pathname} />
    <AdminTopbar client:load user={Astro.locals.user} />
    <main class="px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
      <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          {breadcrumbs.length ? <Breadcrumb items={[{ label: 'Dashboard', href: '/dashboard' }, ...breadcrumbs]} /> : null}
          <h1 class="mt-1 text-2xl font-bold sm:text-3xl">{heading}</h1>
          {description ? <p class="mt-1 text-sm text-ink-500">{description}</p> : null}
        </div>
        <div class="flex gap-2"><slot name="actions" /></div>
      </header>
      <slot />
    </main>
  </div>
</BaseLayout>
