---
import AuthLayout from '@/components/templates/AuthLayout.astro'
import { ResetPasswordForm } from '@/components/organisms/auth/ResetPasswordForm'

const token = Astro.url.searchParams.get('token')
if (!token) return Astro.redirect('/auth/signin')
---

<AuthLayout title="Atur ulang password" heading="Atur password baru" subheading="Gunakan minimal 8 karakter yang mudah kamu ingat.">
  <ResetPasswordForm client:load token={token} />
</AuthLayout>
